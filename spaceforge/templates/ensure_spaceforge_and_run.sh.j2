#!/bin/sh

set -e

# Hooks start in the project root. Module test runs leave
# TF_VAR_spacelift_project_root empty, so remember where we started.
hook_dir="$PWD"

cd {{plugin_path}}

venv_dir="$PWD/venv"
venv_python="$venv_dir/bin/python"
requirements_marker="$venv_dir/.spaceforge_installed_requirements"

if [ ! -x "$venv_python" ] || [ ! -f "$venv_dir/bin/activate" ] || ! "$venv_python" -c 'import sys' >/dev/null 2>&1; then
    rm -rf "$venv_dir"
    python -m venv --copies --system-site-packages "$venv_dir"
fi
. "$venv_dir/bin/activate"

if ! "$venv_python" -c 'import spaceforge' >/dev/null 2>&1; then
    "$venv_python" -m pip install spaceforge
fi

if [ -f requirements.txt ] && [ ! -f "$requirements_marker" ]; then
    "$venv_python" -m pip install -r requirements.txt
    touch "$requirements_marker"
fi
{% if has_binaries %}
export PATH="/mnt/workspace/plugins/plugin_binaries:$PATH"
{% endif %}
if [ -n "$TF_VAR_spacelift_project_root" ]; then
    cd "/mnt/workspace/source/$TF_VAR_spacelift_project_root"
else
    cd "$hook_dir"
fi
"$venv_python" -m spaceforge run --plugin-file {{plugin_file}} {{phase}}